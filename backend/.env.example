# FitFlow backend configuration TEMPLATE.
#
# Copy to `backend/.env` and fill in real values. `.env` is git-ignored;
# this file is tracked, so it must only ever contain names and placeholders.
# Never paste a real key, password or token into this file.

# ── Application ───────────────────────────────────────────────────────────
APP_NAME=FitFlow
# True prints every SQL statement. Use False in any shared/hosted environment.
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────
# Local development (SQLite file, created automatically):
DATABASE_URL=sqlite+aiosqlite:///./fitflow.db
# Hosted PostgreSQL (postgres:// and postgresql:// are converted to asyncpg):
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# ── JWT authentication ────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Also keys the email-OTP hashes. Changing it logs everyone out.
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── AI providers (leave empty to use the offline fallbacks) ───────────────
GEMINI_API_KEY=
# Model ID; see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
CLARIFAI_PAT=

# ── Legacy / not yet wired (safe to leave empty) ──────────────────────────
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend (CORS allow-list) ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email verification (one-time code at signup) ──────────────────────────
# When True, accounts must confirm an emailed code before they can log in,
# which needs working SMTP below. Set False only for local work without SMTP.
EMAIL_VERIFICATION_REQUIRED=True

# Sender address: a real, bare address on a domain you control and have set
# up for sending (SPF/DKIM/DMARC). Example format only: no-reply@example.com
EMAIL_FROM=
EMAIL_FROM_NAME=FitFlow

# SMTP server details come from your mail provider. Port 587 normally uses
# STARTTLS; port 465 normally uses implicit TLS (set SMTP_USE_SSL=True).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=10

# OTP policy (defaults shown)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
UNVERIFIED_ACCOUNT_TTL_HOURS=24
